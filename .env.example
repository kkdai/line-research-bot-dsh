GCP_PROJECT_ID=
GCP_LOCATION=global
# Optional; defaults to gemini-3.8-flash. Must match the LiteLLM model alias.
GEMINI_MODEL=
GCS_BUCKET=line-reports
# Firestore collections are <prefix>users / reports / workspaces.
FIRESTORE_COLLECTION_PREFIX=line_bot_dsh_
CLOUD_TASKS_QUEUE=research-jobs-dsh
CLOUD_TASKS_LOCATION=asia-east1
CLOUD_RUN_SERVICE_URL=
SERVICE_ACCOUNT_EMAIL=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LiteLLM sidecar (Anthropic Messages → Gemini). `make litellm` starts one locally.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-local-change-me-0123456789
DSH_HOME=/tmp/dsh-home

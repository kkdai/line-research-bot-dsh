{
  "name": "line-research-bot-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "LINE research bot on Cloud Run, with research agents running on DeepSeek Harness (DSH) and Gemini on Vertex AI behind a LiteLLM sidecar.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@google-cloud/firestore": "9.4.0",
    "@google-cloud/storage": "8.4.0",
    "@google-cloud/tasks": "7.3.1",
    "@google/genai": "2.32.0",
    "@line/bot-sdk": "11.4.0",
    "google-auth-library": "11.3.2",
    "marked": "18.1.3",
    "marked-footnote": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
